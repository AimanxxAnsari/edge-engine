#!/bin/sh
# Block any push whose commits contain local-brain/ files
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  if git log --name-only --pretty=format: $range | grep -q '^local-brain/'; then
    echo "BLOCKED: push contains local-brain/ files. They must never reach GitHub." >&2
    exit 1
  fi
done
